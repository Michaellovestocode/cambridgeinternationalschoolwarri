# Student-only connector settings. Copy this file to .env.student and fill in locally.
F495_IP=192.168.1.100
F495_PORT=5500
F495_PASSWORD=0
# SDK communication device ID for this reader; set to 4 for the Years 4-6 machine when confirmed.
F495_DEVICE_ID=4
F495_SDK_PATH=C:\Program Files (x86)\RAMS-2980
# First test only: keep the Laravel student receiver ID at 00002.
STUDENT_WEBSITE_URL=https://www.cambridgeinternationalschoolwarri.com/student/iclock/cdata?SN=00002
POLL_SECONDS=5
# Optional: ignore older stored punches; leave blank to sync all new records.
MIN_EVENT_DATE=
